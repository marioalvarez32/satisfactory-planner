{
  "plugins": ["prettier-plugin-vue"],
  "singleQuote": true,
  "semi": true,
  "vueIndentScriptAndStyle": true,
  "endOfLine": "auto",
  "trailingComma": "es5",
  "arrowParens": "always",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": "*.vue",
      "options": {
        "printWidth": 180,
        "tabWidth": 2,
        "useTabs": false,
        "singleQuote": false,
        "semi": false,
        "bracketSpacing": true,
        "arrowParens": "avoid",
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
